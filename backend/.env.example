# Supply via IDE environment variables or a project-local launcher. Not loaded implicitly.
SPRING_PROFILES_ACTIVE=demo
QIXU_DB_URL=jdbc:mysql://127.0.0.1:3306/qixu?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8
# M7 fixed single-host driver/pool budgets are validated before opening a pool.
# Host-specific timeout overrides and multi-host JDBC URLs are rejected.
# connect=3000ms, socket=30000ms, acquisition=3000ms, validation=2000ms;
# every application connection has SESSION innodb_lock_wait_timeout=10s.
QIXU_DB_USERNAME=qixu_app
QIXU_DB_PASSWORD=replace-with-local-password
QIXU_PORT=6967
QIXU_BIND=127.0.0.1
QIXU_COOKIE_SECURE=false
QIXU_ALLOWED_ORIGINS=http://localhost:6968,http://127.0.0.1:6968,http://localhost:6969,http://127.0.0.1:6969
QIXU_NODE=node
QIXU_RANDOM_VERIFIER=randomness/verify.mjs
# Optional explicit deployment proxy; never a runtime-selected beacon URL or seed.
QIXU_RANDOM_PROXY=

# M6 explicit identity integration. Disabled by default; never a student JWT form.
QIXU_DARK_ROOM_ENABLED=false
QIXU_DARK_ROOM_AUTH_URI=
QIXU_DARK_ROOM_LOOPBACK=false
# Supply an independent base64-encoded 32-byte key privately only when enabled.
QIXU_EXTERNAL_TICKET_KEY=

# M7 recovery witness: dev path is relative to the JVM working directory.
# Deploy with a persistent absolute path outside the MySQL data/SQL restore target.
QIXU_RECOVERY_JOURNAL=.qixu/transactions.journal
# Empty on a fresh DB. A stopped pre-V10 adoption requires explicit operator review;
# ADOPT_PRE_V10_ONCE cannot bypass a missing/corrupt existing generation.
QIXU_RECOVERY_BASELINE=
